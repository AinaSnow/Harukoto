<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="喵扑候选" Width="672" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" SizeToContent="Height"
        FontFamily="Microsoft YaHei UI, Yu Gothic UI">
    <Border Padding="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <DockPanel x:Name="CompositionHeader" Margin="2,0,2,8">
                <Border x:Name="PageChip" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <TextBlock x:Name="PageIndicator" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </Border>
                <TextBlock x:Name="Preedit" FontSize="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </DockPanel>
            <WrapPanel x:Name="Candidates"/>
        </StackPanel>
    </Border>
</Window>
